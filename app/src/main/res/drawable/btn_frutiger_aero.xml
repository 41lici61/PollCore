<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0088CC"
                android:endColor="#00A3E0"
                android:angle="90" />
            <stroke
                android:width="1dp"
                android:color="#B3E5FF" />
            <corners android:radius="28dp" />
            <size android:height="56dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00A3E0"
                android:endColor="#0088CC"
                android:angle="90" />
            <stroke
                android:width="1dp"
                android:color="#4DC3F5" />
            <corners android:radius="28dp" />
            <size android:height="56dp" />
        </shape>
    </item>
</selector>