<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme con ActionBar -->
    <style name="Base.Theme.PollCore" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- colores principales -->
        <item name="colorPrimary">@color/frutiger_blue_dark</item>
        <item name="colorPrimaryVariant">@color/frutiger_blue_deep</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- color de la barra de estado -->
        <item name="android:statusBarColor">@color/frutiger_blue_dark</item>

        <!-- clor de fondo de la ventana -->
        <item name="android:windowBackground">@drawable/bg_frutiger_gradient</item>

        <!-- personalizar overflow -->
        <item name="android:popupMenuStyle">@style/Widget.PollCore.PopupMenu</item>
    </style>

    <style name="Theme.PollCore" parent="Base.Theme.PollCore" />

    <!-- estilo menu (los tres puntitos) -->
    <style name="Widget.PollCore.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@color/aero_glass</item>
        <item name="android:textColor">@color/frutiger_blue_dark</item>
    </style>
</resources>